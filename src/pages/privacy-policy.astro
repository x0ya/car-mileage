---
import Layout from '../layouts/Layout.astro';

const title = "Privacy Policy | Real Car Mileage";
const description = "Privacy policy for Real Car Mileage: how we handle browsing data, local storage, cookies and contact requests.";
const keywords = "privacy policy, real car mileage privacy, data protection, no cookies, local storage";
---

<Layout title={title} description={description} keywords={keywords} ogType="article">
  <article class="max-w-3xl mx-auto px-4 py-12">
    <div class="rounded-2xl border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#121215] shadow-sm p-6 sm:p-8 transition-colors">
      <a href="/" class="text-xs text-[#888] dark:text-[#71717a] hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717] dark:focus-visible:ring-white rounded-sm">← Back to home</a>

    <div class="mt-6 font-mono text-xs uppercase tracking-wider text-[#888] dark:text-[#71717a] text-pretty">Legal</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[#171717] dark:text-white text-balance">Privacy Policy</h1>
    <p class="mt-4 text-xs text-[#888] dark:text-[#71717a]">Last updated: October 2026</p>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Overview</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      Real Car Mileage is a free reference and calculator site. We do not require accounts, passwords or personal profiles. We aim to collect as little data as possible.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Information stored on your device</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      If you use the "Request Missing Vehicle" form, the name, year and email you enter are stored only in your browser's local storage on your device. We do not transmit or receive that information on our servers.
    </p>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      Dark-mode preference is also stored in your browser's local storage so the site remembers your theme choice.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Analytics and cookies</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      We do not use advertising cookies, cross-site trackers or behavioural profiling. If basic server-side access logs are generated by the hosting provider, they are used only for security, reliability and aggregated traffic review.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Third-party links</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      The site may link to vehicle pages, fuel-price references and external websites. Those services have their own privacy policies, which you should review separately.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Your choices</h2>
    <ul class="mt-3 space-y-2 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed list-disc pl-5">
      <li>Clear your browser storage or use private browsing to remove locally saved request details and theme preference.</li>
      <li>Disable JavaScript to prevent calculator and local-storage features from running, although parts of the site will stop working.</li>
      <li>Contact us with privacy questions at <a class="text-[#0070f3] hover:underline" href="mailto:privacy@realcarmileage.com">privacy@realcarmileage.com</a>.</li>
    </ul>

    <h2 class="mt-8 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Changes to this policy</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      We may update this privacy policy when features or data practices change. Material changes will be reflected on this page with an updated date.
    </p>
    </div>
  </article>
</Layout>
