---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Real Car Mileage" description="Redirecting to the Contact page of Real Car Mileage." robots="noindex, follow">
  <meta http-equiv="refresh" content="0; url=/contact" />
  <section class="max-w-3xl mx-auto px-4 py-24 text-center">
    <h1 class="text-2xl font-bold text-[#171717] dark:text-white">Redirecting to Contact Us...</h1>
    <p class="mt-4 text-sm text-[#666] dark:text-[#a1a1aa]">
      If you are not redirected automatically, <a href="/contact" class="text-[#0070f3] hover:underline">open the Contact page</a>.
    </p>
  </section>
</Layout>
