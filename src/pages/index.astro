  <!-- Client-side Logic Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const vehicles = window.__VEHICLES__ || [];
      const fuelPrices = window.__FUEL_PRICES__ || {};

      // ---------------------------------------------
      // 1. TAB SWITCHING
      // ---------------------------------------------
      const tabButtons = document.querySelectorAll('.tab-btn');
      const tabContents = document.querySelectorAll('.tab-content');

      function switchTab(targetId, updateHash) {
        if (updateHash === undefined) updateHash = true;
        if (!targetId) return;
        tabButtons.forEach(btn => {
          const isActive = btn.getAttribute('data-tab') === targetId;
          if (isActive) {
            btn.classList.add('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
            btn.classList.remove('text-[#71717a]', 'dark:text-[#a1a1aa]');
          } else {
            btn.classList.remove('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
            btn.classList.add('text-[#71717a]', 'dark:text-[#a1a1aa]');
          }
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          btn.setAttribute('tabindex', isActive ? '0' : '-1');
        });

        tabContents.forEach(content => {
          if (content.id === targetId) {
            content.classList.remove('hidden');
            content.classList.add('block');
            content.removeAttribute('hidden');
          } else {
            content.classList.remove('block');
            content.classList.add('hidden');
            content.setAttribute('hidden', '');
          }
        });

        if (updateHash && window.history && history.replaceState) {
          try { history.replaceState(null, '', '#' + targetId); } catch (e) {}
        }
      }

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          switchTab(target);
        });
        btn.addEventListener('keydown', (e) => {
          const tabs = Array.from(tabButtons);
          const idx = tabs.indexOf(btn);
          let next = idx;
          if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          else return;
          e.preventDefault();
          tabs[next].focus();
          switchTab(tabs[next].getAttribute('data-tab'));
        });
      });

      const initialTab = (location.hash && location.hash.slice(1)) || 'tab-search';
      if (document.getElementById(initialTab)) switchTab(initialTab, false);
      window.addEventListener('hashchange', () => {
        const h = (location.hash || '').slice(1);
        if (h && document.getElementById(h)) switchTab(h, false);
      });

      // ---------------------------------------------
      // 2. METHOD 1: VEHICLE DATABASE FILTER & COMPARISON
      // ---------------------------------------------
      let currentTypeFilter = 'all';
      const typeFilterButtons = document.querySelectorAll('.vtype-btn');
      const makeSelect = document.getElementById('filter-make');
      const modelSelect = document.getElementById('filter-model');
      const variantSelect = document.getElementById('filter-variant');
      const yearSelect = document.getElementById('filter-year');
      const resultCard = document.getElementById('vehicle-result-card');
      const emptyState = document.getElementById('vehicle-empty-state');

      function getFilteredVehicles() {
        return vehicles.filter(v => {
          if (currentTypeFilter !== 'all' && v.type !== currentTypeFilter) return false;
          return true;
        });
      }

      function populateMakes() {
        const filtered = getFilteredVehicles();
        const makes = Array.from(new Set(filtered.map(v => v.make))).sort();
        makeSelect.innerHTML = '<option value="">Select Manufacturer</option>' + 
          makes.map(m => `<option value="${m}">${m}</option>`).join('');
        
        modelSelect.innerHTML = '<option value="">Select Make first</option>';
        modelSelect.disabled = true;
        modelSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';

        variantSelect.innerHTML = '<option value="">Select Model first</option>';
        variantSelect.disabled = true;
        variantSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';

        resultCard.classList.add('hidden');
        emptyState.classList.remove('hidden');
      }

      typeFilterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          typeFilterButtons.forEach(b => {
            b.classList.remove('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
            b.classList.add('text-[#71717a]', 'dark:text-[#a1a1aa]');
          });
          btn.classList.add('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
          btn.classList.remove('text-[#71717a]', 'dark:text-[#a1a1aa]');
          currentTypeFilter = btn.getAttribute('data-vtype');
          populateMakes();
        });
      });

      makeSelect.addEventListener('change', () => {
        const make = makeSelect.value;
        if (!make) {
          modelSelect.innerHTML = '<option value="">Select Make first</option>';
          modelSelect.disabled = true;
          modelSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';
          variantSelect.innerHTML = '<option value="">Select Model first</option>';
          variantSelect.disabled = true;
          variantSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';
          return;
        }

        const models = Array.from(new Set(getFilteredVehicles().filter(v => v.make === make).map(v => v.model))).sort();
        modelSelect.innerHTML = '<option value="">Select Model</option>' + 
          models.map(m => `<option value="${m}">${m}</option>`).join('');
        modelSelect.disabled = false;
        modelSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-[#fafafa] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all';

        variantSelect.innerHTML = '<option value="">Select Model first</option>';
        variantSelect.disabled = true;
        variantSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';
      });

      modelSelect.addEventListener('change', () => {
        const make = makeSelect.value;
        const model = modelSelect.value;
        if (!model) {
          variantSelect.innerHTML = '<option value="">Select Model first</option>';
          variantSelect.disabled = true;
          variantSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed';
          return;
        }

        const matchedVehicles = getFilteredVehicles().filter(v => v.make === make && v.model === model);
        variantSelect.innerHTML = '<option value="">Select Variant</option>' + 
          matchedVehicles.map(v => `<option value="${v.id}">${v.variant} (${v.fuelType})</option>`).join('');
        variantSelect.disabled = false;
        variantSelect.className = 'w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-[#fafafa] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all';
      });

      let selectedVehicle = null;

      variantSelect.addEventListener('change', () => {
        const vId = variantSelect.value;
        if (!vId) {
          resultCard.classList.add('hidden');
          emptyState.classList.remove('hidden');
          selectedVehicle = null;
          return;
        }

        selectedVehicle = vehicles.find(v => v.id === vId);
        if (!selectedVehicle) return;

        // Render card
        document.getElementById('res-badge-type').innerText = selectedVehicle.type.toUpperCase();
        document.getElementById('res-badge-fuel').innerText = selectedVehicle.fuelType;
        document.getElementById('res-badge-trans').innerText = selectedVehicle.transmission;
        document.getElementById('res-vehicle-title').innerText = `${selectedVehicle.make} ${selectedVehicle.model} ${selectedVehicle.variant}`;
        document.getElementById('res-vehicle-subtitle').innerText = 
          `Engine: ${selectedVehicle.engineCc || 'N/A'} cc · Tank Capacity: ${selectedVehicle.tankCapacity} ${selectedVehicle.fuelType === 'CNG' ? 'kg' : (selectedVehicle.fuelType === 'Electric' ? 'kWh' : 'Litres')} · Model Year: ${selectedVehicle.year}`;

        document.getElementById('res-claimed-val').innerText = selectedVehicle.claimedMileage.toFixed(1);
        document.getElementById('res-claimed-unit').innerText = selectedVehicle.unit;

        document.getElementById('res-city-val').innerText = selectedVehicle.realWorldCity.toFixed(1);
        document.getElementById('res-city-unit').innerText = selectedVehicle.unit;

        document.getElementById('res-hwy-val').innerText = selectedVehicle.realWorldHighway.toFixed(1);
        document.getElementById('res-hwy-unit').innerText = selectedVehicle.unit;

        // Calculate variance percentages
        const cityVariance = Math.round(((selectedVehicle.realWorldCity - selectedVehicle.claimedMileage) / selectedVehicle.claimedMileage) * 100);
        const hwyVariance = Math.round(((selectedVehicle.realWorldHighway - selectedVehicle.claimedMileage) / selectedVehicle.claimedMileage) * 100);

        document.getElementById('res-city-variance').innerText = `${cityVariance}%`;
        document.getElementById('res-hwy-variance').innerText = `${hwyVariance > 0 ? '+' : ''}${hwyVariance}%`;

        // Progress bar calculation
        const cityPercentOfClaimed = Math.min(100, Math.round((selectedVehicle.realWorldCity / selectedVehicle.claimedMileage) * 100));
        const gapPercent = 100 - cityPercentOfClaimed;
        document.getElementById('bar-city').style.width = `${cityPercentOfClaimed}%`;
        document.getElementById('bar-gap').style.width = `${gapPercent}%`;
        document.getElementById('res-gap-percent').innerText = `${gapPercent}% lower in city traffic vs official test`;
        document.getElementById('bar-claimed-marker').innerText = `Claimed: ${selectedVehicle.claimedMileage} ${selectedVehicle.unit}`;

        emptyState.classList.add('hidden');
        resultCard.classList.remove('hidden');
      });

      // Quick transfer to Trip Planner
      document.getElementById('use-in-trip-btn').addEventListener('click', () => {
        if (!selectedVehicle) return;
        const avgMileage = Number(((selectedVehicle.realWorldCity + selectedVehicle.realWorldHighway) / 2).toFixed(1));
        document.getElementById('trip-mileage').value = avgMileage;
        switchTab('tab-trip');
        calculateTrip();
      });

      // ---------------------------------------------
      // REQUEST MISSING VEHICLE HANDLER
      // ---------------------------------------------
      const customVehicleBox = document.getElementById('custom-vehicle-box');
      const openCustomBtn = document.getElementById('open-custom-vehicle-btn');
      const closeCustomBtn = document.getElementById('close-custom-vehicle-btn');
      const customVehicleForm = document.getElementById('custom-vehicle-form');
      const requestSuccessAlert = document.getElementById('request-success-alert');
      const submitRequestBtn = document.getElementById('submit-request-btn');

      openCustomBtn.addEventListener('click', () => {
        customVehicleBox.classList.toggle('hidden');
        if (!customVehicleBox.classList.contains('hidden')) {
          document.getElementById('custom-name').focus();
        }
      });

      closeCustomBtn.addEventListener('click', () => {
        customVehicleBox.classList.add('hidden');
      });

      customVehicleForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('custom-name').value.trim();
        const year = document.getElementById('custom-year').value.trim();
        const email = document.getElementById('custom-email').value.trim();

        if (!name) return;

        submitRequestBtn.disabled = true;
        submitRequestBtn.innerText = 'Submitting...';

        // Store request in browser storage so it is tracked
        try {
          const existing = JSON.parse(localStorage.getItem('pending_vehicle_requests') || '[]');
          existing.push({ name, year, email, timestamp: new Date().toISOString() });
          localStorage.setItem('pending_vehicle_requests', JSON.stringify(existing));
        } catch (err) {}

        setTimeout(() => {
          submitRequestBtn.disabled = false;
          submitRequestBtn.innerText = 'Submit Request';
          requestSuccessAlert.classList.remove('hidden');
          customVehicleForm.reset();

          setTimeout(() => {
            requestSuccessAlert.classList.add('hidden');
            customVehicleBox.classList.add('hidden');
          }, 3500);
        }, 500);
      });

      // ---------------------------------------------
      // 3. METHOD 2: CALCULATE MY VEHICLE'S MILEAGE
      // ---------------------------------------------
      const calcDistInput = document.getElementById('calc-distance');
      const calcFuelInput = document.getElementById('calc-fuel');
      const calcPriceInput = document.getElementById('calc-price');
      const unitButtons = document.querySelectorAll('.unit-btn');
      let currentUnitMode = 'metric'; // 'metric' or 'imperial'

      function calculateMileage() {
        const dist = parseFloat(calcDistInput.value) || 0;
        const fuel = parseFloat(calcFuelInput.value) || 0;
        const price = parseFloat(calcPriceInput.value) || 0;

        if (dist <= 0 || fuel <= 0) return;

        let kmpl = 0;
        let mpg = 0;
        let l100 = 0;

        if (currentUnitMode === 'metric') {
          kmpl = dist / fuel;
          mpg = kmpl * 2.35215;
          l100 = (100 * fuel) / dist;
        } else {
          mpg = dist / fuel;
          kmpl = mpg / 2.35215;
          l100 = 235.215 / mpg;
        }

        const costPerKm = (fuel * price) / dist;
        const totalCost = fuel * price;

        document.getElementById('out-mileage-primary').innerText = currentUnitMode === 'metric' ? kmpl.toFixed(2) : mpg.toFixed(2);
        document.getElementById('out-mileage-unit').innerText = currentUnitMode === 'metric' ? 'km/l' : 'MPG';

        document.getElementById('out-mileage-mpg').innerText = `${mpg.toFixed(1)} MPG`;
        document.getElementById('out-mileage-l100').innerText = `${l100.toFixed(2)} L/100km`;

        document.getElementById('out-cost-per-km').innerText = `₹${costPerKm.toFixed(2)}`;
        document.getElementById('out-total-cost').innerText = `₹${totalCost.toLocaleString('en-IN', { maximumFractionDigits: 2 })}`;

        // Dynamic badge rating
        const badge = document.getElementById('out-efficiency-badge');
        if (kmpl >= 20) {
          badge.innerText = 'Super Efficient (Low Running Cost)';
          badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800';
        } else if (kmpl >= 14) {
          badge.innerText = 'Balanced Daily Efficiency';
          badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300 border border-blue-200 dark:border-blue-800';
        } else if (kmpl >= 9) {
          badge.innerText = 'Moderate / High Consumption';
          badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800';
        } else {
          badge.innerText = 'Heavy Consumption (Performance/SUV)';
          badge.className = 'inline-block mt-2 px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800';
        }
      }

      [calcDistInput, calcFuelInput, calcPriceInput].forEach(inp => {
        inp.addEventListener('input', calculateMileage);
      });

      unitButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          unitButtons.forEach(b => {
            b.classList.remove('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
            b.classList.add('text-[#71717a]', 'dark:text-[#a1a1aa]');
          });
          btn.classList.add('bg-white', 'dark:bg-[#27272a]', 'text-[#171717]', 'dark:text-white', 'shadow-xs');
          btn.classList.remove('text-[#71717a]', 'dark:text-[#a1a1aa]');

          currentUnitMode = btn.getAttribute('data-unit');
          document.querySelectorAll('.unit-dist-label').forEach(el => el.innerText = currentUnitMode === 'metric' ? 'km' : 'miles');
          document.querySelectorAll('.unit-fuel-label').forEach(el => el.innerText = currentUnitMode === 'metric' ? 'Litres' : 'Gallons');
          calculateMileage();
        });
      });

      document.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          calcDistInput.value = btn.getAttribute('data-dist');
          calcFuelInput.value = btn.getAttribute('data-fuel');
          calculateMileage();
        });
      });

      // ---------------------------------------------
      // 4. METHOD 3: TRIP COST & FUEL PLANNER
      // ---------------------------------------------
      const tripDistInput = document.getElementById('trip-distance');
      const tripMileageInput = document.getElementById('trip-mileage');
      const tripPriceInput = document.getElementById('trip-fuel-price');
      const roundTripToggle = document.getElementById('trip-roundtrip-toggle');
      const passengerSlider = document.getElementById('trip-passengers');
      const passengerCountLabel = document.getElementById('trip-passenger-count');
      const splitContainer = document.getElementById('out-split-container');
      const splitPerPerson = document.getElementById('out-split-per-person');

      function calculateTrip() {
        let dist = parseFloat(tripDistInput.value) || 0;
        const mileage = parseFloat(tripMileageInput.value) || 0;
        const price = parseFloat(tripPriceInput.value) || 0;
        const passengers = parseInt(passengerSlider.value) || 1;

        if (roundTripToggle.checked) {
          dist = dist * 2;
        }

        if (dist <= 0 || mileage <= 0) return;

        const fuelRequired = dist / mileage;
        const totalTripCost = fuelRequired * price;
        const costPerKm = totalTripCost / dist;
        const costPerPassenger = totalTripCost / passengers;

        document.getElementById('out-trip-total-cost').innerText = Math.round(totalTripCost).toLocaleString('en-IN');
        document.getElementById('out-trip-fuel-litres').innerText = `${fuelRequired.toFixed(2)} L`;
        document.getElementById('out-trip-cost-per-km').innerText = `₹${costPerKm.toFixed(2)}`;
        document.getElementById('out-trip-total-dist').innerText = `${dist} km`;

        const tanks = (fuelRequired / 40).toFixed(1);
        document.getElementById('out-trip-refills').innerText = tanks < 1 ? '< 1 Full Tank' : `~${tanks} Tank fills`;

        passengerCountLabel.innerText = `${passengers} ${passengers === 1 ? 'Person' : 'People'}`;
        if (passengers > 1) {
          splitContainer.classList.remove('hidden');
          splitPerPerson.innerText = `₹${Math.round(costPerPassenger).toLocaleString('en-IN')}`;
        } else {
          splitContainer.classList.add('hidden');
        }
      }

      [tripDistInput, tripMileageInput, tripPriceInput, roundTripToggle, passengerSlider].forEach(el => {
        el.addEventListener('input', calculateTrip);
      });

      // Region fuel presets
      document.querySelectorAll('.state-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const state = pill.getAttribute('data-state');
          if (fuelPrices[state]) {
            tripPriceInput.value = fuelPrices[state].petrol;
            calculateTrip();
          }
        });
      });

      // Copy trip summary
      document.getElementById('copy-trip-btn').addEventListener('click', () => {
        const dist = document.getElementById('out-trip-total-dist').innerText;
        const cost = document.getElementById('out-trip-total-cost').innerText;
        const fuel = document.getElementById('out-trip-fuel-litres').innerText;
        const perKm = document.getElementById('out-trip-cost-per-km').innerText;

        const summary = `🚗 Real Car Mileage Trip Plan\nDistance: ${dist}\nFuel Required: ${fuel}\nTotal Fuel Cost: ₹${cost} (${perKm}/km)\nCalculated on realcarmileage.com`;
        navigator.clipboard.writeText(summary).then(() => {
          const btn = document.getElementById('copy-trip-btn');
          const original = btn.innerHTML;
          btn.innerHTML = '✓ Copied to Clipboard!';
          btn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
          setTimeout(() => {
            btn.innerHTML = original;
            btn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
          }, 2000);
        });
      });

      // Initial runs
      populateMakes();
      calculateMileage();
      calculateTrip();
    });
  </script>
</Layout>

