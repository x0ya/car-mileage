---
import Layout from '../layouts/Layout.astro';
import { VEHICLE_DATABASE, FUEL_PRICES_BY_STATE } from '../data/vehicles';
import '../styles/global.css';

const makes = Array.from(new Set(VEHICLE_DATABASE.map(v => v.make))).sort();
const years = Array.from(new Set(VEHICLE_DATABASE.map(v => v.year))).sort((a,b) => b - a);
const stateCities = Object.keys(FUEL_PRICES_BY_STATE);
const totalVehiclesCount = VEHICLE_DATABASE.length;
const totalCarsCount = VEHICLE_DATABASE.filter(v => v.type === 'car').length;
const totalBikesCount = VEHICLE_DATABASE.filter(v => v.type === 'bike').length;
---

<Layout>
  <!-- Hero Section with subtle Vercel-like mesh glow (dark & light adapted) -->
  <section class="relative overflow-hidden pt-12 pb-16 border-b border-[#ebebeb] dark:border-[#27272a] bg-gradient-to-b from-white dark:from-[#0d0d0f] to-[#fafafa] dark:to-[#09090b] transition-colors">
    <!-- Ambient mesh gradient accent -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[680px] h-[340px] bg-gradient-to-r from-blue-500/10 dark:from-blue-500/15 via-purple-500/10 dark:via-purple-500/15 to-emerald-500/10 dark:to-emerald-500/15 blur-3xl opacity-80"></div>
    
    <div class="max-w-5xl mx-auto px-4 relative text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-xs text-[#666] dark:text-[#a1a1aa] font-mono mb-6 shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        <span>Independent Automotive Road-Test Database</span>
      </div>
      
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#171717] dark:text-white max-w-3xl mx-auto leading-[1.08]">
        Don't trust ARAI claims blindly. Check <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#171717] dark:from-white via-[#444] dark:via-[#d4d4d8] to-[#888] dark:to-[#71717a]">Real Mileage.</span>
      </h1>
      
      <p class="mt-4 text-base sm:text-lg text-[#666] dark:text-[#a1a1aa] max-w-2xl mx-auto leading-relaxed">
        Compare manufacturer claimed km/l against real-world city & highway road tests, measure exact fuel consumed, and compute true trip costs in ₹.
      </p>

      <!-- Mode Selector Pills (Vercel Tabs) -->
      <div class="mt-10 inline-flex p-1 rounded-xl bg-[#f4f4f5] dark:bg-[#18181b] border border-[#e4e4e7] dark:border-[#27272a] gap-1 shadow-xs max-w-full overflow-x-auto" id="calculator-tabs">
        <button type="button" data-tab="tab-search" class="tab-btn active px-4 py-2 rounded-lg text-xs font-medium transition-all bg-white dark:bg-[#27272a] text-[#171717] dark:text-white shadow-xs cursor-pointer flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Vehicle Mileage Explorer
        </button>
        <button type="button" data-tab="tab-calc" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-[#71717a] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
          Calculate My Mileage
        </button>
        <button type="button" data-tab="tab-trip" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-[#71717a] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white transition-all cursor-pointer flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Trip Cost and Fuel Planner (₹)
        </button>
      </div>
    </div>
  </section>

  <!-- Interactive Section Container -->
  <section class="max-w-5xl mx-auto px-4 -mt-4 pb-20">

    <!-- ================= METHOD 1: VEHICLE SEARCH & REAL-WORLD COMPARISON ================= -->
    <div id="tab-search" class="tab-content block">
      <div class="bg-white dark:bg-[#121215] rounded-2xl border border-[#ebebeb] dark:border-[#27272a] shadow-sm overflow-hidden p-6 sm:p-8 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#ebebeb] dark:border-[#27272a]">
          <div>
            <span class="font-mono text-xs text-[#888] dark:text-[#71717a] uppercase tracking-wider">Database Lookup</span>
            <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-white tracking-tight mt-0.5">Claimed vs Real-World Vehicle Mileage</h2>
            <p class="text-xs sm:text-sm text-[#666] dark:text-[#a1a1aa] mt-1">Select make, model, variant, and year to see true fuel economy in Indian traffic conditions.</p>
          </div>
          <!-- Vehicle Type Toggle -->
          <div class="inline-flex p-1 bg-[#f4f4f5] dark:bg-[#18181b] rounded-lg border border-[#e4e4e7] dark:border-[#27272a] self-start sm:self-auto" id="type-filter-group">
            <button type="button" data-vtype="all" class="vtype-btn active px-3 py-1.5 text-xs font-medium rounded-md bg-white dark:bg-[#27272a] text-[#171717] dark:text-white shadow-xs cursor-pointer">All</button>
            <button type="button" data-vtype="car" class="vtype-btn px-3 py-1.5 text-xs font-medium rounded-md text-[#71717a] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white cursor-pointer">Cars</button>
            <button type="button" data-vtype="bike" class="vtype-btn px-3 py-1.5 text-xs font-medium rounded-md text-[#71717a] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white cursor-pointer">Bikes</button>
          </div>
        </div>


        <!-- Filter Form -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-6">
          <div>
            <label for="filter-make" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Manufacturer / Make</label>
            <select id="filter-make" class="w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-[#fafafa] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all">
              <option value="">Select Manufacturer</option>
              {makes.map(m => <option value={m}>{m}</option>)}
            </select>
          </div>

          <div>
            <label for="filter-model" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Model</label>
            <select id="filter-model" disabled class="w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed">
              <option value="">Select Make first</option>
            </select>
          </div>

          <div>
            <label for="filter-variant" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Variant & Transmission</label>
            <select id="filter-variant" disabled class="w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#52525b] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all disabled:cursor-not-allowed">
              <option value="">Select Model first</option>
            </select>
          </div>

          <div>
            <label for="filter-year" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Model Year</label>
            <select id="filter-year" class="w-full px-3 py-2.5 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-[#fafafa] focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white transition-all">
              {years.map(y => <option value={y}>{y}</option>)}
            </select>
          </div>
        </div>

        <!-- Request Vehicle Trigger -->
        <div class="mt-4 flex items-center justify-between text-xs text-[#888] dark:text-[#71717a] pt-1">
          <span>Can't find your specific vehicle or trim?</span>
          <button type="button" id="open-custom-vehicle-btn" class="font-medium text-[#171717] dark:text-white underline hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Request Missing Vehicle
          </button>
        </div>

        <!-- Request Vehicle Form Drawer -->
        <div id="custom-vehicle-box" class="mt-5 p-5 rounded-xl border border-[#ebebeb] dark:border-[#27272a] bg-[#fafafa] dark:bg-[#18181b] hidden transition-all">
          <div class="flex items-center justify-between pb-3 border-b border-[#ebebeb] dark:border-[#27272a] mb-4">
            <div>
              <h4 class="text-sm font-semibold text-[#171717] dark:text-white">Request Vehicle Addition</h4>
              <p class="text-xs text-[#666] dark:text-[#a1a1aa] mt-0.5">Let our editorial team verify and add this car or bike to our road-test database.</p>
            </div>
            <button type="button" id="close-custom-vehicle-btn" class="text-xs text-[#888] hover:text-[#171717] dark:hover:text-white cursor-pointer px-2 py-1 rounded bg-[#ebebeb] dark:bg-[#27272a]">
              ✕ Close
            </button>
          </div>

          <form id="custom-vehicle-form" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            <div>
              <label for="custom-name" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1">Make, Model & Variant</label>
              <input type="text" id="custom-name" required placeholder="e.g. Skoda Octavia vRS 2.0 TSI" class="w-full px-3 py-2 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#121215] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white" />
            </div>

            <div>
              <label for="custom-year" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1">Model Year</label>
              <input type="number" id="custom-year" min="2000" max="2026" placeholder="e.g. 2023" class="w-full px-3 py-2 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#121215] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white font-mono" />
            </div>

            <div>
              <label for="custom-email" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1">Your Email (Optional)</label>
              <input type="email" id="custom-email" placeholder="To notify when added" class="w-full px-3 py-2 text-xs sm:text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#121215] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white" />
            </div>

            <div class="flex items-end">
              <button type="submit" id="submit-request-btn" class="w-full py-2 px-4 rounded-lg text-xs font-medium bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-black dark:hover:bg-zinc-200 transition-all cursor-pointer shadow-xs">
                Submit Request
              </button>
            </div>
          </form>

          <!-- Success Alert -->
          <div id="request-success-alert" class="hidden mt-4 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Thank you! Your request has been queued for verification and will be added to the verified database shortly.</span>
          </div>
        </div>

        <!-- Vehicle Details Result Card -->
        <div id="vehicle-result-card" class="mt-8 pt-8 border-t border-[#ebebeb] dark:border-[#27272a] hidden">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6">
            <div>
              <div class="inline-flex items-center gap-2 mb-1.5">
                <span id="res-badge-type" class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-[#f4f4f5] dark:bg-[#18181b] text-[#555] dark:text-[#a1a1aa] font-semibold border border-[#e4e4e7] dark:border-[#27272a]">Car</span>
                <span id="res-badge-fuel" class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 font-semibold border border-blue-200 dark:border-blue-900">Petrol</span>
                <span id="res-badge-trans" class="px-2 py-0.5 rounded text-[10px] font-mono uppercase bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-semibold">Manual</span>
              </div>
              <h3 id="res-vehicle-title" class="text-2xl font-bold text-[#171717] dark:text-white tracking-tight">Maruti Suzuki Swift ZXi MT</h3>
              <p id="res-vehicle-subtitle" class="text-xs text-[#666] dark:text-[#a1a1aa] mt-0.5">Engine: 1197 cc &middot; Tank Capacity: 37 Litres</p>
            </div>

            <!-- Quick Action button to fill into Trip Planner -->
            <button type="button" id="use-in-trip-btn" class="px-4 py-2.5 rounded-lg text-xs font-medium bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-black dark:hover:bg-zinc-200 transition-all flex items-center gap-1.5 self-start md:self-auto cursor-pointer shadow-xs">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
              Calculate Trip Cost with this Mileage
            </button>
          </div>

          <!-- Comparison Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <!-- Claimed Card -->
            <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#27272a] bg-[#fafafa] dark:bg-[#18181b]">
              <div class="flex items-center justify-between text-xs text-[#666] dark:text-[#a1a1aa] font-mono">
                <span>ARAI CLAIMED</span>
                <span class="text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 px-1.5 py-0.5 rounded text-[10px] font-semibold">Official</span>
              </div>
              <div class="mt-3 flex items-baseline gap-1">
                <span id="res-claimed-val" class="text-3xl font-extrabold text-[#171717] dark:text-white tracking-tight">24.8</span>
                <span id="res-claimed-unit" class="text-xs font-mono text-[#888] dark:text-[#71717a]">km/l</span>
              </div>
              <p class="text-[11px] text-[#888] dark:text-[#71717a] mt-2">Tested under ideal laboratory conditions.</p>
            </div>

            <!-- Real-World City Card -->
            <div class="p-5 rounded-xl border border-amber-200/60 dark:border-amber-900/40 bg-amber-50/30 dark:bg-amber-950/20">
              <div class="flex items-center justify-between text-xs text-amber-900 dark:text-amber-300 font-mono">
                <span>REAL WORLD: CITY</span>
                <span id="res-city-variance" class="text-amber-800 dark:text-amber-300 bg-amber-100/80 dark:bg-amber-900/40 px-1.5 py-0.5 rounded text-[10px] font-bold">-29%</span>
              </div>
              <div class="mt-3 flex items-baseline gap-1">
                <span id="res-city-val" class="text-3xl font-extrabold text-[#171717] dark:text-white tracking-tight">17.5</span>
                <span id="res-city-unit" class="text-xs font-mono text-[#888] dark:text-[#71717a]">km/l</span>
              </div>
              <p class="text-[11px] text-[#777] dark:text-[#a1a1aa] mt-2">Stop-and-go metro traffic with AC engaged.</p>
            </div>

            <!-- Real-World Highway Card -->
            <div class="p-5 rounded-xl border border-blue-200/60 dark:border-blue-900/40 bg-blue-50/30 dark:bg-blue-950/20">
              <div class="flex items-center justify-between text-xs text-blue-900 dark:text-blue-300 font-mono">
                <span>REAL WORLD: HIGHWAY</span>
                <span id="res-hwy-variance" class="text-blue-800 dark:text-blue-300 bg-blue-100/80 dark:bg-blue-900/40 px-1.5 py-0.5 rounded text-[10px] font-bold">-10%</span>
              </div>
              <div class="mt-3 flex items-baseline gap-1">
                <span id="res-hwy-val" class="text-3xl font-extrabold text-[#171717] dark:text-white tracking-tight">22.2</span>
                <span id="res-hwy-unit" class="text-xs font-mono text-[#888] dark:text-[#71717a]">km/l</span>
              </div>
              <p class="text-[11px] text-[#777] dark:text-[#a1a1aa] mt-2">Cruising speeds (75-90 km/h) on open expressway.</p>
            </div>
          </div>

          <!-- Variance Bar Indicator -->
          <div class="mt-6 p-4 rounded-xl border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#18181b]">
            <div class="flex items-center justify-between text-xs mb-2">
              <span class="font-medium text-[#171717] dark:text-white">Claimed vs Reality Gap Analysis</span>
              <span id="res-gap-percent" class="font-mono text-xs text-rose-600 dark:text-rose-400 font-semibold">Average 21% lower in daily driving</span>
            </div>
            <div class="w-full bg-[#f4f4f5] dark:bg-[#27272a] h-3 rounded-full overflow-hidden flex">
              <div id="bar-city" class="bg-amber-400 dark:bg-amber-500 h-full transition-all duration-500" style="width: 70%;" title="City Output"></div>
              <div id="bar-gap" class="bg-zinc-200 dark:bg-zinc-700 h-full transition-all duration-500" style="width: 30%;" title="Unattained Claim"></div>
            </div>
            <div class="flex items-center justify-between text-[11px] font-mono text-[#888] dark:text-[#71717a] mt-2">
              <span>0 km/l</span>
              <span id="bar-claimed-marker">Max ARAI Claim: 24.8 km/l</span>
            </div>
          </div>
        </div>

        <!-- Empty state placeholder when no vehicle selected -->
        <div id="vehicle-empty-state" class="mt-8 pt-8 border-t border-[#ebebeb] dark:border-[#27272a] text-center py-8">
          <div class="w-12 h-12 rounded-full bg-[#f4f4f5] dark:bg-[#18181b] text-[#888] dark:text-[#71717a] mx-auto flex items-center justify-center mb-3">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h4 class="text-sm font-semibold text-[#171717] dark:text-white">No Vehicle Selected</h4>
          <p class="text-xs text-[#888] dark:text-[#71717a] mt-1 max-w-sm mx-auto">Choose a brand and model above to view ARAI claimed figures alongside independently tested CarWale & BikeWale real-world highway and city mileage.</p>
        </div>
      </div>
    </div>


    <!-- ================= METHOD 2: MEASURE MY VEHICLE'S MILEAGE ================= -->
    <div id="tab-calc" class="tab-content hidden">
      <div class="bg-white dark:bg-[#121215] rounded-2xl border border-[#ebebeb] dark:border-[#27272a] shadow-sm overflow-hidden p-6 sm:p-8 transition-colors">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#ebebeb] dark:border-[#27272a]">
          <div>
            <span class="font-mono text-xs text-[#888] dark:text-[#71717a] uppercase tracking-wider">Fuel Consumption Test</span>
            <h2 class="text-xl sm:text-2xl font-bold text-[#171717] dark:text-white tracking-tight mt-0.5">Calculate Your Actual Vehicle Mileage</h2>
            <p class="text-xs sm:text-sm text-[#666] dark:text-[#a1a1aa] mt-1">Tank-to-tank method: enter distance driven and fuel added to reveal your exact mileage & running cost.</p>
          </div>
          <!-- Unit toggle (Metric vs Imperial) -->
          <div class="inline-flex p-1 bg-[#f4f4f5] dark:bg-[#18181b] rounded-lg border border-[#e4e4e7] dark:border-[#27272a] self-start sm:self-auto" id="unit-toggle-group">
            <button type="button" data-unit="metric" class="unit-btn active px-3 py-1.5 text-xs font-medium rounded-md bg-white dark:bg-[#27272a] text-[#171717] dark:text-white shadow-xs cursor-pointer">Metric (km, L)</button>
            <button type="button" data-unit="imperial" class="unit-btn px-3 py-1.5 text-xs font-medium rounded-md text-[#71717a] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white cursor-pointer">Imperial (Miles, Gal)</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mt-6">
