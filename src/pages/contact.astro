---
import Layout from '../layouts/Layout.astro';

const title = "Contact Real Car Mileage | Feedback, Missing Vehicles and Support";
const description = "Contact Real Car Mileage for feedback, missing vehicle requests, mileage corrections, partnership questions or general support.";
const keywords = "contact real car mileage, missing vehicle request, mileage correction, automotive support, feedback";
---

<Layout title={title} description={description} keywords={keywords} ogType="article">
  <article class="max-w-3xl mx-auto px-4 py-12">
    <div class="rounded-2xl border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#121215] shadow-sm p-6 sm:p-8 transition-colors">
      <a href="/" class="text-xs text-[#888] dark:text-[#71717a] hover:text-[#171717] dark:hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#171717] dark:focus-visible:ring-white rounded-sm">← Back to home</a>

    <div class="mt-6 font-mono text-xs uppercase tracking-wider text-[#888] dark:text-[#71717a] text-pretty">Contact us</div>
    <h1 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-[#171717] dark:text-white text-balance">Contact Real Car Mileage</h1>
    <p class="mt-4 text-base text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      We welcome feedback, corrections, missing-vehicle requests and general questions. This is a static site, so form submissions open your email client.
    </p>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#121215]">
        <div class="text-xs font-mono text-[#888] dark:text-[#71717a]">General support</div>
        <a class="mt-2 block text-sm font-medium text-[#171717] dark:text-white hover:text-[#0070f3] transition-colors" href="mailto:support@realcarmileage.com">support@realcarmileage.com</a>
        <p class="mt-2 text-xs text-[#666] dark:text-[#a1a1aa]">Mileage questions, calculator issues and database feedback.</p>
      </div>
      <div class="p-5 rounded-xl border border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#121215]">
        <div class="text-xs font-mono text-[#888] dark:text-[#71717a]">Privacy queries</div>
        <a class="mt-2 block text-sm font-medium text-[#171717] dark:text-white hover:text-[#0070f3] transition-colors" href="mailto:privacy@realcarmileage.com">privacy@realcarmileage.com</a>
        <p class="mt-2 text-xs text-[#666] dark:text-[#a1a1aa]">Privacy policy, data practices and local-storage questions.</p>
      </div>
    </div>

    <h2 class="mt-10 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Send a message</h2>
    <form action="mailto:support@realcarmileage.com" method="post" enctype="text/plain" class="mt-4 space-y-4">
      <div>
        <label for="name" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Name</label>
        <input id="name" name="name" type="text" autocomplete="name" spellcheck="false" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white" />
      </div>
      <div>
        <label for="email" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white" />
      </div>
      <div>
        <label for="subject" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Subject</label>
        <select id="subject" name="subject" class="w-full px-4 py-2.5 text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white">
          <option>Missing vehicle request</option>
          <option>Mileage correction</option>
          <option>Calculator or technical issue</option>
          <option>Business or content enquiry</option>
          <option>Other</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-xs font-medium text-[#444] dark:text-[#d4d4d8] mb-1.5">Message</label>
        <textarea id="message" name="message" rows="5" required class="w-full px-4 py-2.5 text-sm rounded-lg border border-[#d4d4d8] dark:border-[#27272a] bg-white dark:bg-[#18181b] text-[#171717] dark:text-white focus:outline-none focus:ring-2 focus:ring-[#171717] dark:focus:ring-white"></textarea>
      </div>
      <button type="submit" class="px-5 py-2.5 rounded-lg text-sm font-medium bg-[#171717] dark:bg-white text-white dark:text-[#171717] hover:bg-black dark:hover:bg-zinc-200 transition-all">Open email draft</button>
    </form>

    <h2 class="mt-10 text-xl font-semibold text-[#171717] dark:text-white text-balance scroll-mt-24">Response time</h2>
    <p class="mt-3 text-sm text-[#444] dark:text-[#d4d4d8] leading-relaxed">
      We aim to reply within five to seven business days. Vehicle database requests are reviewed in batches, so approved additions may appear in a later release.
    </p>
    </div>
  </article>
</Layout>
