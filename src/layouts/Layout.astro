---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Real Car Mileage — Claimed vs Real-World Fuel Economy & Trip Cost Calculator",
  description = "Search claimed vs real-world mileage (km/l) for popular Indian cars and bikes from CarWale & BikeWale tests, calculate actual fuel efficiency, and estimate exact trip costs in ₹."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://realcarmileage.com" />
    
    <!-- Geist Font Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Anti-flicker Dark Mode Script -->
    <script is:inline>
      if (
        localStorage.getItem('theme') === 'dark' ||
        (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-[#fafafa] dark:bg-[#09090b] text-[#171717] dark:text-[#f4f4f5] antialiased min-h-screen flex flex-col font-['Geist',-apple-system,BlinkMacSystemFont,sans-serif] selection:bg-[#171717] selection:text-white dark:selection:bg-white dark:selection:text-black transition-colors duration-200">
    <!-- Top announcement / status bar -->
    <div class="border-b border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#0d0d0f] text-xs text-[#666] dark:text-[#a1a1aa] py-1.5 px-4 text-center transition-colors">
      <span class="inline-flex items-center gap-1.5 font-mono text-[11px]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>realcarmileage.com</span>
        <span class="text-[#bbb] dark:text-[#3f3f46]">|</span>
        <span class="text-[#171717] dark:text-[#fafafa] font-medium">Verified CarWale & BikeWale Road-Test Benchmarks</span>
      </span>
    </div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#09090b]/80 border-b border-[#ebebeb] dark:border-[#27272a] transition-colors">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-[#171717] dark:bg-[#fafafa] text-white dark:text-[#171717] flex items-center justify-center font-bold text-sm tracking-tighter group-hover:scale-105 transition-transform">
            RM
          </div>
          <div class="flex flex-col">
            <span class="font-semibold text-sm tracking-tight text-[#171717] dark:text-[#fafafa] leading-none">Real Car Mileage</span>
            <span class="font-mono text-[10px] text-[#888] dark:text-[#71717a] tracking-wider uppercase mt-0.5">realcarmileage.com</span>
          </div>
        </a>

        <!-- Quick method anchor links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-[#666] dark:text-[#a1a1aa]">
          <a href="#tab-search" class="hover:text-[#171717] dark:hover:text-white transition-colors">1. Vehicle Database</a>
          <a href="#tab-calc" class="hover:text-[#171717] dark:hover:text-white transition-colors">2. Fuel Calculator</a>
          <a href="#tab-trip" class="hover:text-[#171717] dark:hover:text-white transition-colors">3. Trip Cost Planner</a>
        </nav>

        <div class="flex items-center gap-3">
          <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono bg-[#f4f4f5] dark:bg-[#18181b] border border-[#e4e4e7] dark:border-[#27272a] text-[#52525b] dark:text-[#a1a1aa]">
            <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            ARAI vs True Mileage
          </span>

          <!-- Dark Mode Toggle Button (Vercel Style) -->
          <button 
            type="button" 
            id="theme-toggle" 
            aria-label="Toggle dark mode" 
            class="w-8 h-8 rounded-lg border border-[#e4e4e7] dark:border-[#27272a] bg-white dark:bg-[#18181b] flex items-center justify-center text-[#52525b] dark:text-[#a1a1aa] hover:text-[#171717] dark:hover:text-white hover:border-[#171717] dark:hover:border-white transition-all cursor-pointer shadow-xs"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="theme-toggle-dark-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Vercel-style clean footer -->
    <footer class="border-t border-[#ebebeb] dark:border-[#27272a] bg-white dark:bg-[#0d0d0f] py-12 mt-20 transition-colors">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-xs text-[#888] dark:text-[#71717a]">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-semibold text-sm text-[#171717] dark:text-[#fafafa]">Real Car Mileage</span>
            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-[#f4f4f5] dark:bg-[#18181b] text-[#555] dark:text-[#a1a1aa] border border-[#e4e4e7] dark:border-[#27272a]">v1.2.0</span>
          </div>
          <p class="max-w-md text-[#666] dark:text-[#a1a1aa] leading-relaxed">
            Data-backed fuel economy comparison, trip budget planner, and true running costs for cars and motorcycles across India. Tested benchmarks curated from real-world road tests.
          </p>
        </div>

        <div class="flex flex-col md:items-end gap-2 font-mono text-[11px]">
          <div>Domain: <span class="text-[#171717] dark:text-[#fafafa] font-medium">realcarmileage.com</span></div>
          <div class="text-[#aaa] dark:text-[#52525b]">Engineered with Astro 5, Tailwind v4 & Geist System</div>
        </div>
      </div>
    </footer>

    <!-- Dark Mode Toggle Script -->
    <script is:inline>
      const themeToggleBtn = document.getElementById('theme-toggle');
      const lightIcon = document.getElementById('theme-toggle-light-icon');
      const darkIcon = document.getElementById('theme-toggle-dark-icon');

      function syncThemeIcons() {
        if (document.documentElement.classList.contains('dark')) {
          lightIcon.classList.remove('hidden');
          darkIcon.classList.add('hidden');
        } else {
          lightIcon.classList.add('hidden');
          darkIcon.classList.remove('hidden');
        }
      }

      syncThemeIcons();

      themeToggleBtn.addEventListener('click', () => {
        if (document.documentElement.classList.contains('dark')) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        syncThemeIcons();
      });
    </script>
  </body>
</html>
